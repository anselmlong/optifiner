# =============================================================================
# Optifiner Worker - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# LLM Provider (required - choose one)
# -----------------------------------------------------------------------------
# Provider: "anthropic", "google", or "openai"
MODEL_PROVIDER=google
MODEL_NAME=gemini-2.5-flash

# API keys - only the key for your chosen provider is required
GOOGLE_API_KEY=your-google-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# -----------------------------------------------------------------------------
# Evolution Parameters (optional - these are the defaults)
# -----------------------------------------------------------------------------
# Number of parallel agents per generation
AGENTS=5

# Number of evolution generations to run
GENERATIONS=3

# Max tool calls (read/write/edit file, run eval) per agent per generation
MAX_ITERATIONS=15

# How many agents to run in parallel at once
PARALLEL=4

# -----------------------------------------------------------------------------
# Execution (optional)
# -----------------------------------------------------------------------------
# Timeout in seconds for each agent's total execution
EXECUTION_TIMEOUT=300

# Timeout in seconds for each benchmark/evaluator run
BENCHMARK_TIMEOUT=60

# Where to store isolated workspaces during evolution runs
# Defaults to /tmp/optifiner_workspaces
WORKSPACE_ROOT=/tmp/optifiner_workspaces
