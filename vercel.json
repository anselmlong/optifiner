{
  "version": 2,
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.11" }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "api/main.py" },
    { "source": "/health", "destination": "api/main.py" },
    { "source": "/", "destination": "api/main.py" }
  ]
}
