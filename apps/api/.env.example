# =============================================================================
# Optifiner API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Note: The API backend is optional. The core CLI in services/worker works
# standalone without any of these services.

# -----------------------------------------------------------------------------
# Database (required for API)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://optifiner:optifiner_dev@localhost:5432/optifiner

# Workspace (where cloned repos are stored during evolution)
WORKER_WORKSPACE_PATH=/tmp/optifiner_workspaces

# -----------------------------------------------------------------------------
# GitHub App Integration (optional - for GitHub-based optimization workflows)
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=

# -----------------------------------------------------------------------------
# CORS (optional - defaults to localhost dev ports)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
